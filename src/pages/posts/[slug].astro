---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const post = entry.data;
---

<Base title={`${post.title} — Transatlantic Intelligence`} description={post.description}>
  <p class="article-back"><a href="/">← All dispatches</a></p>

  <article class="article">
    <h1 class="article-title">
      <span class="t-en">{post.title}</span>
      <span class="t-fr">{post.titleFr || post.title}</span>
    </h1>
    <p class="article-meta">
      <span class="t-en">By <strong>{post.author}</strong> ·</span>
      <span class="t-fr">Par <strong>{post.author}</strong> ·</span>
      <time datetime={post.pubDate.toISOString()}>
        {post.pubDate.toLocaleDateString('en-GB', {
          year: 'numeric', month: 'long', day: 'numeric'
        })}
      </time>
    </p>

    <div class="article-body t-en">
      <Content />
    </div>
    {post.contentFr ? (
      <div class="article-body t-fr" set:html={post.contentFr} />
    ) : (
      <div class="article-body t-fr">
        <Content />
      </div>
    )}

    {post.substackUrl && (
      <p class="article-footer">
        <span class="t-en">
          Also published on <a href={post.substackUrl}>Substack</a>.
          Subscribe to get new dispatches by email.
        </span>
        <span class="t-fr">
          Également publié sur <a href={post.substackUrl}>Substack</a>.
          Abonnez-vous pour recevoir les nouvelles dépêches par e-mail.
        </span>
      </p>
    )}
  </article>
</Base>
